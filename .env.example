# UMBRA environment — copy to .env only if you need to override a default.
#
# Variable NAMES only in this file — never real values. A real .env is
# git-ignored and stays on your machine.
#
# The ONLY environment variable the frontend build/dev server reads is:
#
#   VITE_UMBRA_BACKEND   URL of the local Python ML service.
#                        Default: http://127.0.0.1:8000
#                        Set it only when the backend runs elsewhere
#                        (e.g. another host on your LAN).
#
# Everything else is server-side only. The backend loads a repo-root .env
# automatically when present (never overriding real environment variables).

VITE_UMBRA_BACKEND=http://127.0.0.1:8000

# --------------------------------------------------------------------
# Integration credential vault (server-only)
#
# Freesound credentials are stored ENCRYPTED AT REST in the backend's local
# database (.umbra/integrations.db). This key is the only thing that can
# decrypt them, and it must never live in that database, in Git, or in the
# browser. Generate one with:
#
#   python -m backend.services.credentials generate-key
#
# Losing the key makes stored credentials unrecoverable (re-enter them).
UMBRA_CREDENTIAL_ENCRYPTION_KEY=

# Where the backend keeps local runtime state (credential database, audio
# store). Default: ./.umbra
UMBRA_DATA_DIR=

# --------------------------------------------------------------------
# Freesound via server environment variables (optional, read-only)
#
# Alternative to entering credentials in Settings → Sound Libraries: the
# backend can read them straight from its environment. Values never reach
# the browser either way. Get yours at https://freesound.org/apiv2/apply.
UMBRA_FREESOUND_API_KEY=
UMBRA_FREESOUND_CLIENT_ID=
UMBRA_FREESOUND_CLIENT_SECRET=
UMBRA_FREESOUND_REDIRECT_URI=
# OAuth tokens (epoch milliseconds) — usually managed by the app instead.
UMBRA_FREESOUND_ACCESS_TOKEN=
UMBRA_FREESOUND_REFRESH_TOKEN=
UMBRA_FREESOUND_ACCESS_TOKEN_EXPIRES_AT=

# --------------------------------------------------------------------
# Backend diagnostics
UMBRA_LOG_LEVEL=INFO
