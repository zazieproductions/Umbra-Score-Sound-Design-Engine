# UMBRA environment — copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit it, never paste real credentials into a
# chat, an issue, a PR, a screenshot or a test fixture. If a key is exposed
# anywhere, revoke/rotate it at the provider first, then replace it here.
#
# Full setup + verification: docs/development/FREESOUND.md

# ---------------------------------------------------------------------------
# Freesound (library retrieval) — SERVER-SIDE ONLY
#
# Your Freesound API credential (the "Client secret/Api key" shown at
# freesound.org/apiv2/apply). The backend reads it and calls Freesound on
# behalf of the UI; the browser only ever sees "configured / connected".
#
# Leave it empty to run without Freesound: retrieval then reports
# "not configured" honestly instead of inventing results.
# ---------------------------------------------------------------------------
FREESOUND_API_KEY=

# Optional. Freesound OAuth2 access token for ORIGINAL-quality downloads
# (/apiv2/sounds/<id>/download/ requires OAuth2). Previews work without it.
# FREESOUND_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Frontend / dev server
#
# The ONLY variable the Vite build/dev server reads:
#   VITE_UMBRA_BACKEND  URL of the local Python service.
#                       Default: http://127.0.0.1:8000
#                       Set it only when the backend runs elsewhere.
#
# NOTE: VITE_* variables are inlined into the browser bundle. Never put a
# secret in a VITE_ variable — it would ship to every visitor.
# ---------------------------------------------------------------------------
VITE_UMBRA_BACKEND=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Advanced / testing only — do not set unless you know why.
#
#   FREESOUND_API_BASE             point the client at a mock/other API base
#   FREESOUND_ALLOWED_MEDIA_HOSTS  extra hosts the preview proxy may fetch from
#   UMBRA_ENV_FILE                 read the env from a different file
#   UMBRA_LOG_LEVEL                DEBUG | INFO | WARNING | ERROR
#   UMBRA_WORKERS                  background generation workers (default 1)
# ---------------------------------------------------------------------------
